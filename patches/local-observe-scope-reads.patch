diff --git a/test/observe-scope-reads.test.ts b/test/observe-scope-reads.test.ts
new file mode 100644
index 0000000..359135d
--- /dev/null
+++ b/test/observe-scope-reads.test.ts
@@ -0,0 +1,103 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { mockKV, mockSdk } from "./helpers/mocks.js";
+
+vi.mock("../src/logger.js", () => ({
+  logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+
+const SESSION = "ses_scope_reads";
+const SCOPE = `mem:obs:${SESSION}`;
+
+function payload(observationId?: string) {
+  return {
+    sessionId: SESSION,
+    hookType: "post_tool_use",
+    timestamp: new Date().toISOString(),
+    ...(observationId ? { observationId } : {}),
+    data: {
+      tool_name: "Read",
+      tool_input: { file_path: "src/foo.ts" },
+      tool_output: "file contents here",
+    },
+  };
+}
+
+async function setup(maxObservationsPerSession?: number) {
+  const { registerObserveFunction } = await import("../src/functions/observe.js");
+  const sdk = mockSdk({ looseTrigger: true });
+  const kv = mockKV();
+  const listed: string[] = [];
+  const list = kv.list;
+  kv.list = async <T>(scope: string): Promise<T[]> => {
+    listed.push(scope);
+    return list<T>(scope);
+  };
+  registerObserveFunction(sdk as never, kv as never, undefined, maxObservationsPerSession);
+  return { sdk, kv, listed };
+}
+
+describe("mem::observe reads of the session's observation scope", () => {
+  beforeEach(() => {
+    vi.resetModules();
+    process.env["AGENTMEMORY_AUTO_COMPRESS"] = "true";
+  });
+  afterEach(() => {
+    delete process.env["AGENTMEMORY_AUTO_COMPRESS"];
+  });
+
+  it("never lists the scope with auto-compress on and no cap", async () => {
+    const { sdk, listed } = await setup();
+
+    const fresh = (await sdk.trigger("mem::observe", payload())) as { observationId?: string };
+    const durable = (await sdk.trigger("mem::observe", payload("obs_durable_00000001"))) as {
+      observationId?: string;
+    };
+
+    expect(fresh.observationId).toBeTruthy();
+    expect(durable.observationId).toBe("obs_durable_00000001");
+    expect(listed).not.toContain(SCOPE);
+  });
+
+  it("dedups a durable id already stored without listing the scope", async () => {
+    const { sdk, kv, listed } = await setup();
+    await kv.set(SCOPE, "obs_durable_00000002", {
+      id: "obs_durable_00000002",
+      sessionId: SESSION,
+      title: "Read",
+      narrative: "",
+      type: "file_read",
+      facts: [],
+      concepts: [],
+      files: [],
+    });
+
+    const result = (await sdk.trigger("mem::observe", payload("obs_durable_00000002"))) as {
+      deduplicated?: boolean;
+      existing?: boolean;
+    };
+
+    expect(result.deduplicated).toBe(true);
+    expect(result.existing).toBe(true);
+    expect(listed).not.toContain(SCOPE);
+  });
+
+  it("still lists the scope to enforce a per-session cap", async () => {
+    const { sdk, kv, listed } = await setup(1);
+    await kv.set(SCOPE, "obs_existing_0000001", { id: "obs_existing_0000001", sessionId: SESSION });
+
+    const result = (await sdk.trigger("mem::observe", payload())) as { success?: boolean; error?: string };
+
+    expect(listed).toContain(SCOPE);
+    expect(result.success).toBe(false);
+    expect(result.error).toMatch(/limit reached/);
+  });
+
+  it("still lists the scope for the synthetic path's source budget", async () => {
+    delete process.env["AGENTMEMORY_AUTO_COMPRESS"];
+    const { sdk, listed } = await setup();
+
+    await sdk.trigger("mem::observe", payload());
+
+    expect(listed).toContain(SCOPE);
+  });
+});
