+import { describe, it, expect, vi, afterEach } from "vitest";
+import { mockKV, mockSdk } from "./helpers/mocks.js";
+import { observationRowTotals, sessionObservationTotals } from "../src/state/observation-tally.js";
+import type { CompressedObservation } from "../src/types.js";
+
+vi.mock("../src/logger.js", () => ({
+  logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+
+const SESSION = "ses_scope_reads";
+const SCOPE = `mem:obs:${SESSION}`;
+const xml =
+  "<type>file_read</type><title>Read configuration</title><facts><fact>Port configured</fact></facts><narrative>Read the configuration file.</narrative><concepts><concept>config</concept></concepts><files></files><importance>5</importance>";
+
+function payload(observationId?: string) {
+  return {
+    sessionId: SESSION,
+    hookType: "post_tool_use",
+    timestamp: new Date().toISOString(),
+    ...(observationId ? { observationId } : {}),
+    data: {
+      tool_name: "Read",
+      tool_input: { file_path: "src/foo.ts" },
+      tool_output: "file contents here",
+    },
+  };
+}
+
+function storedRow(id: string): CompressedObservation {
+  return {
+    id,
+    sessionId: SESSION,
+    timestamp: new Date().toISOString(),
+    type: "file_read",
+    title: "Read",
+    narrative: "Read a file.",
+    facts: [],
+    concepts: [],
+    files: [],
+    importance: 5,
+  } as CompressedObservation;
+}
+
+function countingKV() {
+  const kv = mockKV();
+  const listed: string[] = [];
+  const list = kv.list;
+  kv.list = async <T>(scope: string): Promise<T[]> => {
+    listed.push(scope);
+    return list<T>(scope);
+  };
+  return { kv, listed: () => listed.filter((s) => s === SCOPE).length };
+}
+
+describe("observation scope reads", () => {
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  it("observe with auto-compress and no cap never lists the scope", async () => {
+    vi.stubEnv("AGENTMEMORY_AUTO_COMPRESS", "true");
+    const { registerObserveFunction } = await import("../src/functions/observe.js");
+    const sdk = mockSdk({ looseTrigger: true });
+    const { kv, listed } = countingKV();
+    registerObserveFunction(sdk as never, kv as never);
+
+    for (let i = 0; i < 5; i++) await sdk.trigger("mem::observe", payload());
+    const durable = (await sdk.trigger("mem::observe", payload("obs_durable_00000001"))) as { observationId?: string };
+
+    expect(durable.observationId).toBe("obs_durable_00000001");
+    expect(listed()).toBe(0);
+  });
+
+  it("observe dedups a stored durable id with a single get", async () => {
+    vi.stubEnv("AGENTMEMORY_AUTO_COMPRESS", "true");
+    const { registerObserveFunction } = await import("../src/functions/observe.js");
+    const sdk = mockSdk({ looseTrigger: true });
+    const { kv, listed } = countingKV();
+    registerObserveFunction(sdk as never, kv as never);
+    await kv.set(SCOPE, "obs_durable_00000002", storedRow("obs_durable_00000002"));
+
+    const result = (await sdk.trigger("mem::observe", payload("obs_durable_00000002"))) as {
+      deduplicated?: boolean;
+      existing?: boolean;
+    };
+
+    expect(result).toMatchObject({ deduplicated: true, existing: true });
+    expect(listed()).toBe(0);
+  });
+
+  it("observe enforces the per-session cap with one list across writes", async () => {
+    vi.stubEnv("AGENTMEMORY_AUTO_COMPRESS", "false");
+    const { registerObserveFunction } = await import("../src/functions/observe.js");
+    const sdk = mockSdk({ looseTrigger: true });
+    const { kv, listed } = countingKV();
+    registerObserveFunction(sdk as never, kv as never, undefined, 3);
