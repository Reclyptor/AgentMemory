new file mode 100644
index 0000000..9ca1bcc
--- /dev/null
+++ b/src/state/observation-tally.ts
@@ -0,0 +1,141 @@
+import type { CompressedObservation } from "../types.js";
+import { payloadByteLength } from "./frame-guard.js";
+
+// Running per-session totals of a session's observation scope, so the source
+// budget doesn't list the whole scope on every write. A session's scope grows
+// without bound, and once it outgrows one engine frame a list can't be read at
+// all. Every write to an observation scope must be reported through
+// noteObservationWrite (StateKV does this); totals load with one list the first
+// time a session needs them.
+
+const OBSERVATION_SCOPE_PREFIX = "mem:obs:";
+const MAX_TRACKED_SESSIONS = 64;
+
+export type ObservationRowTotals = { rows: number; bytes: number; sourceBytes: number };
+
+type RowContribution = { bytes: number; sourceBytes: number };
+
+type SessionTally = {
+  rows: Map<string, RowContribution>;
+  bytes: number;
+  sourceBytes: number;
+};
+
+type KvTallies = {
+  sessions: Map<string, SessionTally>;
+  writes: Map<string, number>;
+  unreadable: Set<string>;
+};
+
+type ListingKV = { list<T = unknown>(scope: string): Promise<T[]> };
+
+const byKv = new WeakMap<object, KvTallies>();
+
+function talliesFor(kv: object): KvTallies {
+  let tallies = byKv.get(kv);
+  if (!tallies) {
+    tallies = { sessions: new Map(), writes: new Map(), unreadable: new Set() };
+    byKv.set(kv, tallies);
+  }
+  return tallies;
+}
+
+export function observationRowContribution(row: CompressedObservation): RowContribution {
+  return {
+    bytes: payloadByteLength(row),
+    sourceBytes: row.source ? payloadByteLength(row.source) + 10 : 0,
+  };
+}
+
+export function observationRowTotals(rows: CompressedObservation[]): ObservationRowTotals {
+  let bytes = 0;
+  let sourceBytes = 0;
+  for (const row of rows) {
+    const c = observationRowContribution(row);
+    bytes += c.bytes;
+    sourceBytes += c.sourceBytes;
+  }
+  return { rows: rows.length, bytes, sourceBytes };
+}
+
+function isRow(value: unknown): value is CompressedObservation {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+// value: the row now stored, null when the key was deleted, or undefined when
+// the new value isn't known (the session's totals are dropped and reload).
+export function noteObservationWrite(kv: object, scope: string, key: string, value: unknown): void {
+  if (!scope.startsWith(OBSERVATION_SCOPE_PREFIX)) return;
+  const sessionId = scope.slice(OBSERVATION_SCOPE_PREFIX.length);
+  const tallies = talliesFor(kv);
+  tallies.writes.set(sessionId, (tallies.writes.get(sessionId) ?? 0) + 1);
+  const tally = tallies.sessions.get(sessionId);
+  if (!tally) return;
+  if (value === undefined) {
+    tallies.sessions.delete(sessionId);
+    return;
+  }
+  const previous = tally.rows.get(key);
+  if (previous) {
+    tally.bytes -= previous.bytes;
+    tally.sourceBytes -= previous.sourceBytes;
+    tally.rows.delete(key);
+  }
+  if (isRow(value)) {
+    const next = observationRowContribution(value);
+    tally.rows.set(key, next);
+    tally.bytes += next.bytes;
+    tally.sourceBytes += next.sourceBytes;
+  }
+}
+
+async function loadTally(kv: ListingKV, tallies: KvTallies, sessionId: string): Promise<SessionTally | null> {
+  const cached = tallies.sessions.get(sessionId);
+  if (cached) {
+    tallies.sessions.delete(sessionId);
+    tallies.sessions.set(sessionId, cached);
+    return cached;
+  }
+  if (tallies.unreadable.has(sessionId)) return null;
+  const writesBefore = tallies.writes.get(sessionId) ?? 0;
+  let rows: CompressedObservation[];
+  try {
+    rows = (await kv.list<CompressedObservation>(`${OBSERVATION_SCOPE_PREFIX}${sessionId}`)).filter(isRow);
+  } catch {
+    tallies.unreadable.add(sessionId);
+    return null;
+  }
+  const tally: SessionTally = { rows: new Map(), bytes: 0, sourceBytes: 0 };
+  for (const row of rows) {
+    const c = observationRowContribution(row);
+    tally.rows.set(row.id, c);
+    tally.bytes += c.bytes;
+    tally.sourceBytes += c.sourceBytes;
+  }
+  // A write that landed while the list was in flight may or may not be in it,
+  // so the result is good for this call only.
+  if ((tallies.writes.get(sessionId) ?? 0) !== writesBefore) return tally;
+  tallies.sessions.set(sessionId, tally);
+  if (tallies.sessions.size > MAX_TRACKED_SESSIONS) {
+    const oldest = tallies.sessions.keys().next().value;
+    if (oldest !== undefined) tallies.sessions.delete(oldest);
+  }
+  return tally;
+}
+
+// Totals for the session's stored observations, leaving out excludeId (the row
+// a write is about to replace). Null when the scope can't be read.
+export async function sessionObservationTotals(
+  kv: ListingKV,
+  sessionId: string,
+  excludeId?: string,
+): Promise<ObservationRowTotals | null> {
+  const tally = await loadTally(kv, talliesFor(kv), sessionId);
+  if (!tally) return null;
+  const excluded = excludeId ? tally.rows.get(excludeId) : undefined;
+  return {
+    rows: tally.rows.size - (excluded ? 1 : 0),
+    bytes: tally.bytes - (excluded?.bytes ?? 0),
+    sourceBytes: tally.sourceBytes - (excluded?.sourceBytes ?? 0),
+  };
+}
