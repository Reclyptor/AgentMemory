diff --git a/test/reflect-bounds.test.ts b/test/reflect-bounds.test.ts
new file mode 100644
index 0000000..215f984
--- /dev/null
+++ b/test/reflect-bounds.test.ts
@@ -0,0 +1,122 @@
+import { describe, it, expect, beforeEach, vi } from "vitest";
+import { mockKV, mockSdk } from "./helpers/mocks.js";
+
+vi.mock("../src/logger.js", () => ({
+  logger: { info: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}));
+
+import {
+  registerReflectFunctions,
+  INSIGHT_MAX_SOURCES,
+  REFLECT_MAX_CONCEPTS,
+  REFLECT_MAX_RESPONSE_BYTES,
+} from "../src/functions/reflect.js";
+import { REFLECT_MAX_PROMPT_BYTES, REFLECT_SYSTEM } from "../src/prompts/reflect.js";
+import { fingerprintId } from "../src/state/schema.js";
+import type { Insight } from "../src/types.js";
+
+const RESPONSE = `<insights>
+<insight confidence="0.8" title="Layered checks">
+Validation, safe APIs and tests together catch what each alone misses.
+</insight>
+</insights>`;
+const CONTENT = "Validation, safe APIs and tests together catch what each alone misses.";
+
+// One connected graph cluster of 400 concepts, with far more matching facts and
+// lessons than any prompt or insight should carry.
+async function seedGiantCluster(kv: ReturnType<typeof mockKV>) {
+  const now = "2026-04-01T00:00:00Z";
+  for (let i = 0; i < 400; i++) {
+    await kv.set("mem:graph:nodes", `node_c${i}`, {
+      id: `node_c${i}`, type: "concept", name: `c${i}`, properties: {}, sourceObservationIds: [], createdAt: now,
+    });
+    if (i > 0) {
+      await kv.set("mem:graph:edges", `edge_${i}`, {
+        id: `edge_${i}`, type: "related_to", sourceNodeId: `node_c${i - 1}`, targetNodeId: `node_c${i}`,
+        weight: 1, sourceObservationIds: [], createdAt: now,
+      });
+    }
+  }
+  for (let i = 0; i < 300; i++) {
+    await kv.set("mem:semantic", `sem_${i}`, {
+      id: `sem_${i}`, fact: `c${i % 32} fact number ${i} ${"detail ".repeat(40)}`, confidence: 0.8,
+      sourceSessionIds: [], sourceMemoryIds: [], accessCount: 1, lastAccessedAt: now, strength: 0.8,
+      createdAt: now, updatedAt: now,
+    });
+  }
+  for (let i = 0; i < 100; i++) {
+    await kv.set("mem:lessons", `lsn_${i}`, {
+      id: `lsn_${i}`, content: `lesson ${i} about c${i % 32}`, context: "", confidence: 0.7, reinforcements: 0,
+      source: "manual", sourceIds: [], tags: [`c${i % 32}`], createdAt: now, updatedAt: now, decayRate: 0.05,
+    });
+  }
+}
+
+describe("reflection bounds", () => {
+  let sdk: ReturnType<typeof mockSdk>;
+  let kv: ReturnType<typeof mockKV>;
+  let summarize: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    sdk = mockSdk();
+    kv = mockKV();
+    summarize = vi.fn().mockResolvedValue(RESPONSE);
+    registerReflectFunctions(sdk as never, kv as never, { name: "test", compress: vi.fn(), summarize } as never);
+  });
+
+  it("bounds concepts, provenance and the prompt for a giant cluster", async () => {
+    await seedGiantCluster(kv);
+
+    const result = (await sdk.trigger("mem::reflect", {})) as { success: boolean; newInsights: number };
+    expect(result.success).toBe(true);
+    expect(result.newInsights).toBe(1);
+
+    for (const [system, prompt] of summarize.mock.calls as Array<[string, string]>) {
+      expect(Buffer.byteLength(system) + Buffer.byteLength(prompt)).toBeLessThanOrEqual(REFLECT_MAX_PROMPT_BYTES);
+    }
+    const [insight] = await kv.list<Insight>("mem:insights");
+    expect(insight!.tags.length).toBeLessThanOrEqual(REFLECT_MAX_CONCEPTS);
+    expect(insight!.sourceConceptCluster).toEqual(insight!.tags);
+    expect(insight!.sourceMemoryIds.length).toBeLessThanOrEqual(INSIGHT_MAX_SOURCES);
+    expect(insight!.sourceLessonIds.length).toBeLessThanOrEqual(INSIGHT_MAX_SOURCES);
+  });
+
+  it("shrinks a legacy oversized insight when reflection reinforces it", async () => {
+    await seedGiantCluster(kv);
+    const id = fingerprintId("ins", CONTENT.toLowerCase());
+    const huge = Array.from({ length: 5000 }, (_, i) => `legacy concept ${i}`);
+    await kv.set("mem:insights", id, {
+      id, title: "Layered checks", content: CONTENT, confidence: 0.5, reinforcements: 0,
+      sourceConceptCluster: huge, tags: huge,
+      sourceMemoryIds: Array.from({ length: 1500 }, (_, i) => `sem_old_${i}`),
+      sourceLessonIds: [], sourceCrystalIds: [],
+      createdAt: "2026-04-01T00:00:00Z", updatedAt: "2026-04-01T00:00:00Z", decayRate: 0.05,
+    });
+
+    const result = (await sdk.trigger("mem::reflect", {})) as { reinforced: number };
+    expect(result.reinforced).toBe(1);
+
+    const stored = (await kv.get<Insight>("mem:insights", id))!;
+    expect(stored.reinforcements).toBe(1);
+    expect(stored.tags.length).toBeLessThanOrEqual(REFLECT_MAX_CONCEPTS);
+    expect(stored.sourceMemoryIds.length).toBeLessThanOrEqual(INSIGHT_MAX_SOURCES);
+  });
+
+  it("skips an oversized model response", async () => {
+    await seedGiantCluster(kv);
+    summarize.mockResolvedValue(`${RESPONSE}\n${" ".repeat(REFLECT_MAX_RESPONSE_BYTES)}`);
+
+    const result = (await sdk.trigger("mem::reflect", {})) as { newInsights: number };
+    expect(result.newInsights).toBe(0);
+  });
+
+  it("rejects invalid limits and caps insight list results", async () => {
+    expect(await sdk.trigger("mem::insight-list", { limit: 0 })).toMatchObject({ success: false, invalid: true });
+    expect(await sdk.trigger("mem::insight-search", { query: "x", limit: -1 })).toMatchObject({ success: false, invalid: true });
+    expect(await sdk.trigger("mem::reflect", { maxClusters: 1.5 })).toMatchObject({ success: false, invalid: true });
+  });
+
+  it("keeps the system prompt inside the budget on its own", () => {
+    expect(Buffer.byteLength(REFLECT_SYSTEM)).toBeLessThan(REFLECT_MAX_PROMPT_BYTES / 4);
+  });
+});
